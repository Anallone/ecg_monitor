{
    "version": 4,
    "configurations": [
        {
            "name": "ESP-IDF-v5.5.1-ESP32S3",
            "compileCommands": "${workspaceFolder}/firmware/build/compile_commands.json",
            "compilerPath": "${env:IDF_TOOLS_PATH}/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/bin/xtensa-esp32s3-elf-gcc.exe",
            "intelliSenseMode": "windows-gcc-x64",
            "cStandard": "c17",
            "cppStandard": "c++23",
            "includePath": [
                "${workspaceFolder}/firmware/**",
                "${workspaceFolder}/firmware/managed_components/**",
                "${env:IDF_PATH}/components/**",
                "${env:IDF_TOOLS_PATH}/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include",
                "${env:IDF_TOOLS_PATH}/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/lib/gcc/xtensa-esp-elf/14.2.0/include-fixed",
                "${env:IDF_TOOLS_PATH}/tools/xtensa-esp-elf/esp-14.2.0_20241119/xtensa-esp-elf/xtensa-esp-elf/include"
            ],
            "defines": [
                "ESP_PLATFORM",
                "CONFIG_IDF_TARGET_ESP32S3=1",
                "IDF_VER=\"v5.5.1\""
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/firmware",
                    "${workspaceFolder}/firmware/managed_components",
                    "${env:IDF_PATH}/components"
                ],
                "limitSymbolsToIncludedHeaders": true
            }
        }
    ]
}
