# ESP32-S3 目标芯片
CONFIG_IDF_TARGET="esp32s3"
# 主频
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
# 8MB Flash / 无 PSRAM（微雪 2.8寸屏板默认）
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="8MB"
# 日志
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
# 组件自动管理
CONFIG_IDF_COMPONENT_MANAGER=y
# 蓝牙：演示模式样本经 BLE GATT Notify 推给上位机
# 选 NimBLE 而非 Bluedroid——本板无 PSRAM，NimBLE 内存占用小得多，吞吐足够。
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_ESP_LCD_TOUCH_CST816S_DISABLE_READ_ID=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
# 主任务栈：app_main 里 classify_beat(win[187]+norm[187]) -> ecg_infer(pooled/gate/g/h)
# 整条调用链约 3.5KB，默认 3584 刚好溢出（报 "stack overflow in task main"）。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
